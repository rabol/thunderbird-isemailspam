{
  "manifest_version": 3,
  "name": "IsEmailSpam",
  "version": "1.0.1",
  "description": "Check or report the sender of the displayed message with IsEmailSpam.",
  "author": "Steen Rabol",
  "homepage_url": "https://github.com/rabol/thunderbird-isemailspam",
  "browser_specific_settings": {
    "gecko": {
      "id": "{08b95181-0434-4c51-8bec-1ef92df731b6}",
      "strict_min_version": "147.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["messagesRead", "storage"],
  "host_permissions": ["https://isemailspam.com/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "message_display_action": {
    "default_title": "Check or report this sender with IsEmailSpam",
    "default_label": "IsEmailSpam",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html"
  }
}
